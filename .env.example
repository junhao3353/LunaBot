# 复制成 .env 并填入你自己的值（.env 已被 .gitignore 忽略，不会提交）
# docker compose 会自动读取同目录的 .env

# 你的 QQ 密码（NapCat 快速登录失效时的回退；不填则每次需扫码）
NAPCAT_QUICK_PASSWORD=你的QQ密码
# 上面密码的 MD5（可选，用 md5sum 或 certutil -hashfile 生成）
NAPCAT_QUICK_PASSWORD_MD5=

# OneBot 访问令牌（必须与 NapCat WebUI 网络配置里的 token 一致）
ONEBOT_TOKEN=改成你自己的令牌

# ---------- 抖音解析服务（可选，推荐） ----------
# 解析服务地址（DTK v5：http://dtk-api:8000）
QQ2_DOUYIN_API_BASE=
# 解析服务 API Key（需要 media:read + media:write 权限）
QQ2_DOUYIN_API_KEY=
# 可选：解析服务 media-data 卷挂到本容器后的路径（如 /dtk_media）
QQ2_DOUYIN_MEDIA_DIR=
